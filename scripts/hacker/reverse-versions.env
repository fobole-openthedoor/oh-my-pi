# Pinned reverse-engineering stack matching the reference host (Debian 13).
# Sourced by install-reverse.sh. Keep PROMPT.md in sync when these change.

REVERSE_SKILL_REPO="${REVERSE_SKILL_REPO:-https://github.com/zhaoxuya520/reverse-skill.git}"
REVERSE_SKILL_DIR="${REVERSE_SKILL_DIR:-$HOME/tools/reverse-skill}"

GHIDRA_VERSION="${GHIDRA_VERSION:-12.1.3}"
GHIDRA_TAG="${GHIDRA_TAG:-Ghidra_12.1.3_build}"
GHIDRA_ZIP="${GHIDRA_ZIP:-ghidra_12.1.3_PUBLIC_20260817.zip}"
GHIDRA_DIR_NAME="${GHIDRA_DIR_NAME:-ghidra_12.1.3_PUBLIC}"
GHIDRA_SHA256="${GHIDRA_SHA256:-93a5d11a9ad510622acaaf908c556a7b9b764d338e78a7567f3689bf5081fd54}"
GHIDRA_URL="${GHIDRA_URL:-https://github.com/NationalSecurityAgency/ghidra/releases/download/${GHIDRA_TAG}/${GHIDRA_ZIP}}"

JADX_VERSION="${JADX_VERSION:-1.5.6}"
JADX_ZIP="${JADX_ZIP:-jadx-1.5.6.zip}"
JADX_SHA256="${JADX_SHA256:-545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974}"
JADX_URL="${JADX_URL:-https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/${JADX_ZIP}}"

RE_MCP_GHIDRA_SPEC="${RE_MCP_GHIDRA_SPEC:-re-mcp-ghidra==3.0.3}"
FRIDA_TOOLS_SPEC="${FRIDA_TOOLS_SPEC:-frida-tools==14.10.4}"
OBJECTION_SPEC="${OBJECTION_SPEC:-objection==1.12.5}"
PWNTOOLS_SPEC="${PWNTOOLS_SPEC:-pwntools==4.15.0}"

# Android APK depth sidecar. Decision layer only; not merged into reverse-skill.
APK_REVERSE_REPO="${APK_REVERSE_REPO:-https://github.com/newliver666/apk-reverse.git}"
APK_REVERSE_DIR="${APK_REVERSE_DIR:-$HOME/tools/apk-reverse}"
DROIDASC_SPEC="${DROIDASC_SPEC:-droidasc==0.1.1.post2}"

# ddc 0.1.15 still has `info` / `findrefs` / `-c`. The sidecar's evidence row
# measured 0.1.8; doctor.py reports whatever is on this machine.
DDC_VERSION="${DDC_VERSION:-0.1.15}"
DDC_ASSET_X64="${DDC_ASSET_X64:-ddc-v${DDC_VERSION}-x86_64-unknown-linux-gnu}"
DDC_SHA256_X64="${DDC_SHA256_X64:-945239d320b7fcf4d6a826f735f50221c20b608214a02e6f4ebec4e5f5d96ac7}"
DDC_URL_X64="${DDC_URL_X64:-https://github.com/ejfkdev/ddc/releases/download/v${DDC_VERSION}/${DDC_ASSET_X64}}"
