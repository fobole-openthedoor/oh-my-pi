# Isolated from ~/.bashrc OPENAI_BASE_URL (strix/cige/other agents).
export OMP_AGENT_DIR="$HOME/.omp/agent"
export OMP_FORK_ROOT="${OMP_FORK_ROOT:-$HOME/oh-my-pi}"
export OMP_BIN="${OMP_BIN:-$OMP_FORK_ROOT/packages/coding-agent/scripts/omp}"
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"

export OPENAI_BASE_URL="http://openai.beefsms.com:38888/v1"
# Preferred: in omp run `/login beefsms` and paste the key (URL is already set).
# Optional env fallback. Do not commit this file.
export BEEFSMS_API_KEY="${BEEFSMS_API_KEY:-}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"
export OPENAI_MODEL="happy/kimi-k3"

export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-$HOME/tools/ghidra}"
export GHIDRA_HOME="${GHIDRA_HOME:-$HOME/tools/ghidra}"
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-amd64}"
export REVERSE_SKILL_ROOT="${REVERSE_SKILL_ROOT:-$HOME/tools/reverse-skill}"
export CLAUDE_RED_ROOT="${CLAUDE_RED_ROOT:-$HOME/tools/claude-red}"

export PATH="$HOME/tools/ghidra:$HOME/tools/ghidra/support:$HOME/tools/jadx/bin:$HOME/.local/bin:$BUN_INSTALL/bin:$PATH"

# GLM 5.3 auto-continue. Set 0 to disable.
export GLM_AUTO_CONTINUE="${GLM_AUTO_CONTINUE:-1}"

# Web search: Brave first when this is set. Optional.
export BRAVE_API_KEY="${BRAVE_API_KEY:-}"
