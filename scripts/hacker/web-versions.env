# Pinned web pentest tools for this fork (Debian, linux amd64).
# Sourced by install-web.sh. Apt packages stay on the distro version.

NUCLEI_VERSION="${NUCLEI_VERSION:-3.11.1}"
NUCLEI_ZIP="${NUCLEI_ZIP:-nuclei_${NUCLEI_VERSION}_linux_amd64.zip}"
NUCLEI_SHA256="${NUCLEI_SHA256:-ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6}"
NUCLEI_URL="${NUCLEI_URL:-https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/${NUCLEI_ZIP}}"

HTTPX_VERSION="${HTTPX_VERSION:-1.12.0}"
HTTPX_ZIP="${HTTPX_ZIP:-httpx_${HTTPX_VERSION}_linux_amd64.zip}"
HTTPX_SHA256="${HTTPX_SHA256:-9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76}"
HTTPX_URL="${HTTPX_URL:-https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/${HTTPX_ZIP}}"

SUBFINDER_VERSION="${SUBFINDER_VERSION:-2.16.0}"
SUBFINDER_ZIP="${SUBFINDER_ZIP:-subfinder_${SUBFINDER_VERSION}_linux_amd64.zip}"
SUBFINDER_SHA256="${SUBFINDER_SHA256:-1b7f9c608e9a5bd59e609a5e09710d63c5485e92d3d49dc2c16eb4fdbe10cb60}"
SUBFINDER_URL="${SUBFINDER_URL:-https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_VERSION}/${SUBFINDER_ZIP}}"

SECLISTS_REPO="${SECLISTS_REPO:-https://github.com/danielmiessler/SecLists.git}"
SECLISTS_DIR="${SECLISTS_DIR:-$HOME/tools/SecLists}"
# Web content, DNS names, and a small credential list. Not the full repo.
SECLISTS_SPARSE="${SECLISTS_SPARSE:-Discovery/Web-Content Discovery/DNS Passwords/Common-Credentials}"
